rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isAuthenticated() && 
        request.auth.token.role == 'admin';
    }

    function isTeacher(teacherId) {
      return isAuthenticated() && request.auth.uid == teacherId;
    }

    function isTeacherActive(teacherId) {
      return isTeacher(teacherId) &&
        get(/databases/$(database)/documents/teachers/$(teacherId)).data.isReadOnly == false &&
        request.time < get(/databases/$(database)/documents/teachers/$(teacherId)).data.licenseExpiresAt;
    }

    // Platform Settings & Pricing: Public read, Admin write
    match /platformSettings/{docId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // Licenses: Admin manages, teachers can read and activate their own license
    match /licenses/{licenseId} {
      allow read: if isPlatformAdmin() || 
        (isAuthenticated() && resource.data.teacherId == request.auth.uid);
      allow create, delete: if isPlatformAdmin();
      allow update: if isPlatformAdmin(); // Activation must be performed by trusted backend
    }

    // Teachers Collection
    match /teachers/{teacherId} {
      allow read: if isTeacher(teacherId) || isPlatformAdmin();
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin() || (isTeacher(teacherId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'name', 'photoURL', 'preferredLanguage']));
      allow delete: if isPlatformAdmin();
    }

    // Classes: Multi-tenant isolated to teacherId
    match /classes/{classId} {
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        request.auth.token.classId == classId ||
        isPlatformAdmin()
      );
      // Teachers can only create/update/delete classes if subscription is active
      allow create: if isAuthenticated() && isTeacherActive(request.resource.data.teacherId);
      allow update: if isAuthenticated() && isTeacherActive(resource.data.teacherId) && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if isAuthenticated() && isTeacherActive(resource.data.teacherId);
    }

    // Students: Multi-tenant isolated to teacherId & classId
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        request.auth.uid == studentId ||
        isPlatformAdmin()
      );
      allow create: if isTeacherActive(request.resource.data.teacherId) &&
        exists(/databases/$(database)/documents/classes/$(request.resource.data.classId)) &&
        get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherId == request.auth.uid;
      allow update: if isTeacherActive(resource.data.teacherId) &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.classId == resource.data.classId;
      allow delete: if isTeacherActive(resource.data.teacherId);
    }

    // Learning Attempts: teacher writes only until student auth and server-side scoring are implemented
    match /attempts/{attemptId} {
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        isPlatformAdmin()
      );
      allow create: if isTeacherActive(request.resource.data.teacherId) &&
        request.resource.data.studentId is string &&
        exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherId == request.auth.uid &&
        request.resource.data.classId == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.classId;
      allow update: if false; // Attempts are immutable audit records
      allow delete: if false; // Immutable audit trail
    }

    // Student Progress
    match /studentProgress/{studentId} {
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        request.auth.uid == studentId ||
        isPlatformAdmin()
      );
      allow create: if isTeacherActive(request.resource.data.teacherId) &&
        request.resource.data.studentId == studentId &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.teacherId == request.auth.uid &&
        request.resource.data.classId == get(/databases/$(database)/documents/students/$(studentId)).data.classId;
      allow update: if isTeacherActive(resource.data.teacherId) &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.classId == resource.data.classId &&
        get(/databases/$(database)/documents/students/$(studentId)).data.classId == resource.data.classId &&
        get(/databases/$(database)/documents/students/$(studentId)).data.teacherId == request.auth.uid;
      allow delete: if isPlatformAdmin();
    }

    // Parent report sharing links are retired. Reports are downloaded by teachers as PDFs.
    // Legacy link documents, if any, are inaccessible from the client.
    match /parentReportLinks/{linkId} {
      allow read, write: if false;
    }
  }
}
